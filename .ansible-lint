---
# Rules skipped deliberately, with reasons.
skip_list:
  # Feature-toggle and package blocks in group_vars are column-aligned for
  # readability; that is the point of them, not an accident.
  - yaml[colons]
  - yaml[commas]

  # Roles here are private to this repo and never reused elsewhere, so
  # prefixing every register with the role name is noise. Variables that
  # cross role boundaries (cluster_*, ml_*) already carry a prefix.
  - var-naming[no-role-prefix]

  # A debug task that fires on change is a deliberate operator notice
  # (e.g. "you must re-login for docker group membership"), not a handler.
  - no-handler

exclude_paths:
  - .git/

  # Vault files are ciphertext, not YAML. Line 1 is `$ANSIBLE_VAULT;1.1;AES256`
  # and ansible-lint reports `yaml[document-start]: Missing document start` on
  # it - so `make check` starts failing the moment anyone follows the runbook
  # and creates a vault, which is the one thing the runbook tells you to do.
  # Invisible in CI, because these paths are gitignored; it only ever breaks on
  # the machine of the person who actually set the token up.
  - group_vars/*/vault.yml
  - host_vars/*/vault.yml
