# Managed by gx10-cluster ansible (roles/remote). Local edits are overwritten.
#
# sshd uses the FIRST obtained value for each keyword (not the last). The main
# sshd_config has `Include /etc/ssh/sshd_config.d/*.conf` at line 12, before
# its own directives, so drop-ins win over the defaults below it. Within the
# drop-in directory files are read in lexical order, so a LOW prefix wins --
# hence 10-, not 99-. A 99- file would lose to any earlier fragment, including
# in the dangerous direction (something else turning passwords off).
#
# No `Port` directive: this host socket-activates sshd and ssh.socket owns the
# listen address. See the assert in roles/remote/tasks/main.yml.

PermitRootLogin {{ ssh_permit_root_login }}
PubkeyAuthentication yes

{% if safe_to_disable_passwords | bool %}
# ssh_disable_passwords was set deliberately, with at least one key declared in
# authorized_keys. Nothing on this node probed that the key works - it cannot,
# the private half is not here - so this reflects the operator's assertion, not
# a measurement. See docs/decisions.md.
PasswordAuthentication no
KbdInteractiveAuthentication no
{% else %}
# Password auth deliberately left ENABLED: no declared key has been proven to
# work on this host. Disabling it here would be an unrecoverable lockout.
PasswordAuthentication yes
{% endif %}

{% if ssh_x11_forwarding %}
X11Forwarding yes
{% else %}
# Off: this is a headless compute node reached over SSH, so X11 forwarding is
# one more thing sshd will set up on request for a display nobody has. Set
# ssh_x11_forwarding to turn it back on.
X11Forwarding no
{% endif %}
AllowAgentForwarding yes

# Training runs sit idle at the prompt for hours; do not reap the session.
ClientAliveInterval 60
ClientAliveCountMax 30

MaxAuthTries 4
LoginGraceTime 30
