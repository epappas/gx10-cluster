#!/bin/sh
# ---------------------------------------------------------------------------
# Managed by gx10-cluster ansible (roles/shell). Local edits are overwritten.
# Sourced by ~/.bashrc and ~/.zshrc, so keep this POSIX-compatible and branch
# on $ZSH_VERSION / $BASH_VERSION for anything shell-specific.
#
# Deliberately sets NO NCCL_* variables. NCCL gives the environment precedence
# over /etc/nccl.conf, so exporting them here would override the system config
# for interactive runs only - giving a locally-launched rank and an
# SSH-launched rank different settings. /etc/nccl.conf owns NCCL.
# ---------------------------------------------------------------------------

_gx10_path_prepend() {
    case ":${PATH}:" in
        *":$1:"*) ;;
        *) [ -d "$1" ] && PATH="$1:${PATH}" ;;
    esac
}

_gx10_path_prepend "{{ cuda_home }}/bin"
_gx10_path_prepend "$HOME/.cargo/bin"
# GOBIN's default, where `go install` puts gopls and anything else you install
# that way. roles/dev_go writes nothing to PATH itself - ~/go/bin/gopls is a
# symlink into a version-named directory, so this path never changes when the
# version does.
_gx10_path_prepend "$HOME/go/bin"
_gx10_path_prepend "$HOME/.local/bin"
export PATH

# --- CUDA ------------------------------------------------------------------
export CUDA_HOME="{{ cuda_home }}"
export LD_LIBRARY_PATH="{{ cuda_home }}/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# GB10 is compute capability {{ gpu_arch_list }} (sm_121). Setting this stops
# CUDA extension builds (flash-attn, custom kernels) from compiling for every
# architecture PyTorch knows about.
export TORCH_CUDA_ARCH_LIST="{{ gpu_arch_list }}"

# Lazy module loading cuts process startup time and resident footprint - it
# matters more here than on a discrete GPU, because that footprint comes out
# of the same pool the model weights live in.
export CUDA_MODULE_LOADING=LAZY

# 128 GB is shared coherently between CPU and GPU, so caching-allocator
# fragmentation strands memory the HOST also needs. Expandable segments let
# the allocator grow and shrink instead.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Hugging Face ----------------------------------------------------------
# No HF_HUB_ENABLE_HF_TRANSFER: hf_transfer is gone in huggingface-hub 1.x,
# and setting the variable now only earns a FutureWarning on every import.
# Fast transfers come from hf-xet, which is a hard dependency already.
export HF_HOME="$HOME/.cache/huggingface"

# --- CPU -------------------------------------------------------------------
# The performance cores are {{ perf_cores }}, NOT 0-{{ perf_core_count - 1 }}.
# P-cores (Cortex-X925, 3.90 GHz) and E-cores (Cortex-A725, 2.81 GHz)
# interleave, so the obvious `taskset -c 0-9` straddles both.
alias pcore='taskset -c {{ perf_cores }}'

# Barrier-synchronous work (llama.cpp layers, dataloader collate, OpenMP
# regions) runs at the pace of its slowest thread, so spreading across the
# E-cores makes every barrier wait on them. Match the P-core count.
export OMP_NUM_THREADS={{ perf_core_count }}

# --- Build -----------------------------------------------------------------
# Not MAKEFLAGS: CMAKE_GENERATOR=Ninja means Ninja runs the build, and Ninja
# does not read MAKEFLAGS. These are the knobs that are actually honoured -
# by `cmake --build` and by pip-built CUDA extensions respectively.
export CMAKE_GENERATOR=Ninja
export CMAKE_BUILD_PARALLEL_LEVEL={{ ansible_facts['processor_vcpus'] | default(20) }}
export MAX_JOBS={{ ansible_facts['processor_vcpus'] | default(20) }}
[ -d /usr/lib/ccache ] && _gx10_path_prepend /usr/lib/ccache && export PATH

# --- Node (nvm) ------------------------------------------------------------
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# AFTER nvm, deliberately. The editor's npm language servers live in
# ~/.local/lib/gx10-npm-<hash of the pinned list>, with ~/.local/lib/gx10-npm a
# symlink at the current set - and sourcing nvm.sh above puts nvm's own global
# bin at the FRONT of PATH. Prepending this earlier would leave any leftover
# copy in nvm's prefix shadowing the set roles/editor actually deployed, so a
# version bump would move the symlink and change nothing you can observe.
_gx10_path_prepend "$HOME/.local/lib/gx10-npm/bin"
export PATH

# --- Aliases ---------------------------------------------------------------
alias ml='. {{ ml_venv }}/bin/activate'
alias gpu='nvidia-smi'
alias gpuw='watch -n1 nvidia-smi'

# Ubuntu ships these binaries under different names to avoid collisions.
command -v batcat  >/dev/null 2>&1 && alias bat='batcat' && alias cat='batcat --paging=never'
command -v fdfind  >/dev/null 2>&1 && alias fd='fdfind'

# There were eza aliases here. eza is no longer installed - it was one of three
# Rust CLIs the dev_rust role compiled from source on every fresh box, to get a
# nicer `ls`. The `command -v eza` guard meant the aliases silently did nothing
# once that stopped, taking `ll` with them in zsh, which has no default for it.
alias ll='ls -lah --group-directories-first'

# --- Editor ----------------------------------------------------------------
# roles/editor installs neovim to /opt/nvim-<version> and symlinks it into
# /usr/local/bin. EDITOR is what git, systemctl edit, crontab and `ws` hand
# your text to, so it belongs here rather than in a shell-specific rc.
if command -v nvim > /dev/null 2>&1; then
    export EDITOR=nvim
    export VISUAL=nvim
    # Man pages with syntax highlighting, search and the same keys as
    # everything else. `nvim +Man!` is neovim's own pager mode, not a plugin.
    export MANPAGER='nvim +Man!'
    alias vi='nvim'
    alias vim='nvim'
    alias v='nvim'
fi

# tmux, as on the devbox. `ta` with no argument attaches to the most recent
# session instead of erroring, which is what you want after reconnecting to a
# node you left a training run on.
alias tl='tmux ls'
alias tn='tmux new -s'
alias tk='tmux kill-session -t'
ta() { if [ $# -eq 0 ]; then tmux attach; else tmux attach -t "$1"; fi; }

# --- Prompt ----------------------------------------------------------------
# The prompt was previously left to the shell, which on zsh means bare
# `<host>%`: no user, no path, no branch. On a two-node cluster where you are
# constantly ssh'd into the other box, "which machine am I on" is the single
# most useful thing a prompt can tell you, and the default does not.
#
# user@host  path  branch $
#
# The zsh half is wrapped in eval on purpose. This file is `#!/bin/sh` and the
# header asks for POSIX: `precmd_functions+=(...)` is a PARSE error in dash,
# and a parse error aborts the WHOLE file - taking PATH, CUDA_HOME and every
# alias with it, for a prompt. eval hides that syntax from every parser but
# zsh's own.
#
# vcs_info rather than shelling out to git: it ships with zsh and does not
# fork a process on every prompt.
if [ -n "$ZSH_VERSION" ]; then
    eval '
        autoload -Uz vcs_info
        zstyle ":vcs_info:*" enable git
        zstyle ":vcs_info:git:*" formats " %F{yellow}%b%f"
        zstyle ":vcs_info:git:*" actionformats " %F{red}%b|%a%f"
        precmd_functions+=(vcs_info)
        setopt prompt_subst
        PROMPT="%F{green}%n@%m%f %F{blue}%~%f\${vcs_info_msg_0_} \$ "
    '
elif [ -n "$BASH_VERSION" ]; then
    # bash has no vcs_info, so this does fork - but only in a repo, and only
    # once per prompt. symbolic-ref first so a detached HEAD still shows
    # something useful rather than nothing.
    _gx10_git_branch() {
        _b=$(git symbolic-ref --short HEAD 2>/dev/null) \
            || _b=$(git rev-parse --short HEAD 2>/dev/null) \
            || return 0
        printf ' %s' "$_b"
    }
    PS1='\[\033[32m\]\u@\h\[\033[0m\] \[\033[34m\]\w\[\033[0m\]\[\033[33m\]$(_gx10_git_branch)\[\033[0m\] \$ '
fi

# --- Shell integrations ----------------------------------------------------
if [ -n "$ZSH_VERSION" ]; then
    _gx10_shell=zsh
elif [ -n "$BASH_VERSION" ]; then
    _gx10_shell=bash
else
    _gx10_shell=""
fi

if [ -n "$_gx10_shell" ]; then
    command -v zoxide   >/dev/null 2>&1 && eval "$(zoxide init $_gx10_shell)"
    [ -f "/usr/share/doc/fzf/examples/key-bindings.$_gx10_shell" ] \
        && . "/usr/share/doc/fzf/examples/key-bindings.$_gx10_shell"
fi
unset _gx10_shell
