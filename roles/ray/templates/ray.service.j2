# Managed by gx10-cluster ansible (roles/ray). Local edits are overwritten.
#
# The rank-0 node runs the head, everyone else joins it. Which node that is
# comes from cluster_controller, derived from cluster_rank - never from
# inventory order.
#
# --node-ip-address is the interconnect address, so Ray's object transfers use
# the 200G ConnectX-7 link rather than WiFi. That address only exists once a
# QSFP cable is in; roles/ray refuses to install without it rather than let
# this unit silently bind somewhere slower.

[Unit]
Description=Ray {{ 'head' if inventory_hostname == cluster_controller else 'worker' }} node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ primary_user }}
Environment=HF_HOME={{ primary_home }}/.cache/huggingface
{% if inventory_hostname == cluster_controller %}
ExecStart={{ ml_venv }}/bin/ray start --head --block \
    --node-ip-address={{ cluster_subnets[0] }}.{{ cluster_index }} \
    --port={{ ray_port }} \
    --dashboard-host={{ monitoring_bind }}
{% else %}
ExecStart={{ ml_venv }}/bin/ray start --block \
    --node-ip-address={{ cluster_subnets[0] }}.{{ cluster_index }} \
    --address={{ cluster_master_ip }}:{{ ray_port }}
{% endif %}
ExecStop={{ ml_venv }}/bin/ray stop
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
