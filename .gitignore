*.retry
.vault_pass
# Vault files, in the DIRECTORY form. Ansible auto-loads group_vars/<group>/*
# and host_vars/<host>/*, or a single group_vars/<group>.yml - but NOT
# host_vars/<host>.vault.yml, which is what this used to say. That path parses
# as a host named "<host>.vault" and is silently never read, so the ignore rule
# guarded a file that could not work. Verified with a real play.
group_vars/*/vault.yml
host_vars/*/vault.yml

# Site-specific values that are private but NOT secret - your username, an
# address that differs from the example inventory, a local override you do not
# want to push. Encrypting these with vault would be theatre; keeping them out
# of a public repo is the actual requirement. Same directory form as above, so
# ansible auto-loads them and they outrank group_vars/all.yml.
# Committed defaults -> local.yml (private) -> vault.yml (private + secret).
group_vars/*/local.yml
host_vars/*/local.yml
__pycache__/
.smoke.yml
.idem.log
.ansible/

# Your real inventory - hostnames and addresses. Seeded from
# inventory.example.yml by bootstrap.sh. See docs/decisions.md#private-vars.
inventory.yml

# Editor and tooling backups. inventory.yml.gx10.bak held real addresses and
# was untracked but NOT ignored, so any `git add -A` would have published it.
*.bak
*.orig
*~

# Workspace runtime state: real .env files (tokens, host paths) and pidfiles.
# The tracked .env.example files are the documented template.
workspaces/**/.env
workspaces/**/.pid

# The agent workspaces keep their config, CREDENTIALS and sessions here -
# dsh's .credentials.yaml and pi's auth.json are both real key stores - and
# `work/` is whatever the agent has been pointed at: someone else's source
# tree, not ours to publish. The tracked templates are settings.example.yaml
# and, for pi, the seeding heredoc in its up.sh.
workspaces/agent/*/dsh-home/*
!workspaces/agent/*/dsh-home/.gitkeep
workspaces/agent/*/pi-agent/*
!workspaces/agent/*/pi-agent/.gitkeep
workspaces/agent/*/work/*
!workspaces/agent/*/work/.gitkeep

# Generated by `ws up ray-verl --prepare-data` - verl's own gsm8k preprocessor
# writes it, so it is reproducible rather than authored.
workspaces/rl/ray-verl/data/
