---
extends: default

rules:
  # Ansible playbooks are naturally wide; ansible-lint already caps at 160.
  line-length:
    max: 160
    level: warning
  # Column-aligned blocks in group_vars are deliberate and readable.
  colons:
    max-spaces-after: -1
  commas:
    max-spaces-after: -1
  comments:
    min-spaces-from-content: 1
  # site.yml lists roles as inline maps, which reads better as a table than
  # as nine four-line blocks.
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false

  # Required by ansible-lint for config compatibility. Without these it warns
  # on every run and disables fix mode - a permanent warning you learn to
  # ignore is worse than the rule it protects.
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
