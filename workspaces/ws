#!/usr/bin/env bash
# Workspaces: runnable recipes for inference, cluster and RL environments.
#
# DELIBERATELY NOT ANSIBLE. Ansible's job in this repo ends at "the machine is
# ready" - drivers held, CUDA present, docker usable, RDMA up, weights cached.
# What you then RUN on that machine changes far more often than the machine
# does, and coupling the two means every experiment needs a playbook run and
# every recipe is only reproducible through ansible. So:
#
#   roles/     converge a machine to a state          (slow, rare, privileged)
#   workspaces/ run an environment on a ready machine  (fast, often, unprivileged)
#
# The ONLY coupling is the `requires:` block in each workspace.yml, checked by
# `ws check`. No workspace reads anything from roles/, and no role knows a
# workspace exists. Every recipe here is plain docker/compose or a plain
# command, so you can read it, copy it, and run it by hand without this script.
#
#   ws list                 every workspace, with provenance
#   ws show   <name>        the manifest, readably
#   ws check  <name>        does THIS machine meet its requirements?
#   ws up     <name>        start it (runs check first)
#   ws down   <name>        stop it
#   ws logs   <name> [-f]   tail it
#   ws status               what is running
set -euo pipefail

WS_ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
export WS_ROOT
# shellcheck source-path=SCRIPTDIR source=lib/common.sh
source "$WS_ROOT/lib/common.sh"

# Anchored on content, not line numbers: a hardcoded range silently truncates
# the help text the first time anyone edits the header above it.
usage() { awk '/^#   ws list/,/^#   ws status/ { sub(/^# {0,3}/, ""); print }' "$0"; }

need_name() { [[ -n ${1:-} ]] || die "which workspace? try: ws list"; }

resolve() {  # name -> dir, with a useful error
    local d
    d=$(ws_dir "$1") || die "no workspace '$1'. try: ws list"
    printf '%s' "$d"
}

# Each workspace may ship a .env.example. The real .env is gitignored, so a
# recipe can carry a HF token or a host-specific path without that reaching the
# repo - same three-tier rule as the ansible half
# (docs/decisions.md#private-vars).
load_env() {
    local d=$1
    [[ -f "$d/.env" ]] && { set -a; # shellcheck disable=SC1091
                            source "$d/.env"; set +a; }
    return 0
}

# Compose project names accept [a-z0-9][a-z0-9_-]* and NOTHING ELSE - a dot is
# rejected outright with "invalid project name". Three workspaces here are named
# after a model whose version has a dot in it (qwen3.8), and one of them is the
# single-node default this repo's README opens with, so `ws up` on the first
# thing anyone runs failed on the project name before it reached docker.
#
# Mapped rather than stripped: `qwen3.8-27b` and `qwen38-27b` would otherwise
# both become the same project, and two workspaces sharing a project name is a
# far worse bug than the one being fixed. Uppercase is folded for the same
# reason the rule exists. The `container_name:` in each compose file is already
# dot-free, which is why the containers were never the problem.
ws_project() { printf 'ws-%s' "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')"; }

compose() {  # $1 = dir; rest = compose args
    local d=$1; shift
    ( cd "$d" && docker compose --project-name "$(ws_project "$(basename "$d")")" "$@" )
}

cmd_list() {
    printf '%s%-34s %-10s %-9s %s%s\n' "$c_bold" WORKSPACE KIND ENGINE SUMMARY "$c_off"
    local n d m prov col
    for n in $(ws_all); do
        d=$(ws_dir "$n"); m="$d/workspace.yml"
        prov=$(ws_field "$m" provenance)
        # Provenance is the same discipline the docs use: unlabelled means
        # measured here. A recipe nobody has run says so, in the listing, so
        # you know before you spend an hour on it.
        case "$prov" in
            verified)   col=$c_grn ;;
            unverified) col=$c_yel ;;
            # `blocked` is red for the same reason an unknown value is: it is
            # not "untested", it is "tested, and it did not work". Anything
            # unrecognised keeps falling here too - a manifest with a typo in
            # provenance should look wrong, not look fine.
            *)          col=$c_red ;;
        esac
        printf '%s%-34s%s %-10s %-9s %s\n' "$col" "$n" "$c_off" \
            "$(ws_field "$m" kind)" "$(ws_field "$m" engine)" "$(ws_field "$m" summary)"
    done
    printf '\n%sgreen = run on this hardware · yellow = written, never run · red = run, and blocked%s\n' "$c_dim" "$c_off"
}

cmd_show() {
    need_name "${1:-}"; local d; d=$(resolve "$1")
    cat "$d/workspace.yml"
    printf '\n%s--- files ---%s\n' "$c_dim" "$c_off"
    ls -1 "$d"
    # The manifest says what it NEEDS; the README says when to reach for this
    # one instead of the one next to it. Point at it rather than assuming
    # anyone browses the directory.
    [[ -f "$d/README.md" ]] && printf '\n%sdocs: %s/README.md%s\n' \
        "$c_dim" "${d#"$WS_ROOT"/}" "$c_off"
    return 0
}

cmd_check() {
    need_name "${1:-}"; local d; d=$(resolve "$1")
    printf '%s%s%s\n' "$c_bold" "$1" "$c_off"
    if ws_preflight "$d/workspace.yml"; then
        ok "ready"
    else
        # Not every requirement is Ansible's. GPU, docker and RDMA are;
        # free memory and free disk are things running on the box right now,
        # and telling someone to run a playbook at those wastes their time.
        die "requirements not met - see above.
  GPU / docker / RDMA / peers  -> ansible owns these: make apply
  memory / disk                -> something is using them: gx10-top, df -h"
    fi
}

cmd_up() {
    need_name "${1:-}"; local d; d=$(resolve "$1"); shift
    ws_preflight "$d/workspace.yml" || die "requirements not met - see above"
    load_env "$d"
    if [[ -x "$d/up.sh" ]]; then
        # EXPORTED so an up.sh that drives compose itself uses the SAME project
        # name `ws down`, `ws logs` and `ws status` will look for. Two of them
        # do, and re-deriving it in each was a real bug: `basename | tr -c ...`
        # translates the trailing NEWLINE too, so one side computed
        # `ws-vllm-qwen3-8-27b-nvfp4-` and the other `ws-vllm-qwen3-8-27b-nvfp4`,
        # and a healthy running container became invisible to `ws status` and
        # unstoppable by `ws down`.
        WS_PROJECT=$(ws_project "$(basename "$d")") "$d/up.sh" "$@"
    elif [[ -f "$d/compose.yml" ]]; then
        compose "$d" up -d "$@"
        printf '\n'; ok "started. logs: ws logs $(basename "$d") -f"
        ws_list_field "$d/workspace.yml" endpoints | sed 's/^/  endpoint: /'
    else
        die "workspace has neither up.sh nor compose.yml"
    fi
}

cmd_down() {
    need_name "${1:-}"; local d; d=$(resolve "$1")
    load_env "$d"
    if [[ -x "$d/down.sh" ]]; then "$d/down.sh"
    elif [[ -f "$d/compose.yml" ]]; then compose "$d" down
    else die "workspace has neither down.sh nor compose.yml"; fi
}

cmd_logs() {
    need_name "${1:-}"; local d; d=$(resolve "$1"); shift
    load_env "$d"
    [[ -f "$d/compose.yml" ]] && { compose "$d" logs "$@"; return; }

    # NOT EVERY CONTAINER WORKSPACE IS A COMPOSE WORKSPACE. Five recipes here
    # run `docker run` directly - the two-node launcher cannot use compose at
    # all, because half the containers are on another machine, and the rest
    # branch on a speculator in a way a compose `command:` cannot express.
    # Their logs are in `docker logs`, and telling their users to go looking in
    # ~/.local/state for a file that does not exist was worse than the silence
    # it replaced. The manifest names the container so this does not have to
    # guess it out of a shell script.
    local c; c=$(ws_field "$d/workspace.yml" container)
    [[ -n $c ]] && { exec docker logs "$@" "$c"; }

    die "no compose.yml and no 'container:' in the manifest - this workspace
logs to a FILE, and its up.sh printed the path when it started. Common ones:
  ~/.local/state/ws-*.log          llama.cpp workspaces
  ~/.local/state/gx10-bench/       vllm-bench-serve"
}

cmd_status() {
    local n d any=0
    for n in $(ws_all); do
        d=$(ws_dir "$n")
        [[ -f "$d/compose.yml" ]] || continue
        if [[ -n $(compose "$d" ps -q 2>/dev/null) ]]; then
            any=1; printf '%s%s%s\n' "$c_bold" "$n" "$c_off"
            compose "$d" ps --format '  {{.Service}}  {{.Status}}  {{.Ports}}' 2>/dev/null
        fi
    done
    (( any )) || printf '%sno workspace is running%s\n' "$c_dim" "$c_off"
}

case "${1:-}" in
    list)          shift; cmd_list "$@" ;;
    show)          shift; cmd_show "$@" ;;
    check)         shift; cmd_check "$@" ;;
    up)            shift; cmd_up "$@" ;;
    down)          shift; cmd_down "$@" ;;
    logs)          shift; cmd_logs "$@" ;;
    status)        shift; cmd_status "$@" ;;
    ""|-h|--help)  usage ;;
    *)             die "unknown command '$1'. try: ws --help" ;;
esac
