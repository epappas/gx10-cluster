# Copy to .env (gitignored) and edit. Every value here has a working default in
# compose.yml; this file exists for the ones that are yours.

# HF_TOKEN=hf_...              # only if you hit a gated repo

# Fraction of unified memory vLLM may claim. 0.84 is the DGX Spark figure from
# MiaAI-Lab. Lower it if a desktop session is running - Xorg and gnome-shell
# hold ~1.2 GB of the SAME pool the model wants (see gx10-status).
# GPU_MEMORY_UTILIZATION=0.84

# 1010000 needs YaRN and most of the KV cache budget. Drop to 262144 (native)
# for normal use and you free a lot of memory for concurrency.
# MAX_MODEL_LEN=262144
