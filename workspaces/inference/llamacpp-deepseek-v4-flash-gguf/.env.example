# Copy to .env (gitignored). Everything has a working default.

# Context. 32768 is chosen against the memory budget, not against the model -
# V4-Flash supports 1M and this machine does not have room for it at 2-bit.
# Every doubling here comes out of the same pool as the weights.
# CTX=32768

# Sampling. DeepSeek's published values; top_p 0.95 for agentic use.
# TEMP=1.0
# TOP_P=1.0
# MIN_P=0.01

# Reasoning effort is a request-time field, not a flag. Think High is on by
# default; send --chat-template-kwargs '{"reasoning_effort":"low"}' or
# '{"enable_thinking":false}' in the request to change it. high and max can
# emit up to 384K output tokens, which will not fit in a 32K context.

# THE LADDER, and what each leaves of a ~112 GB budget. Everything from
# UD-IQ3_S (116.1 GB) up does NOT fit one node - listed so nobody spends a
# download finding out.
#
#   UD-IQ1_S     82.5 GB   ~29 GB left
#   UD-IQ1_M     86.9 GB   ~25 GB left
#   UD-IQ2_M     90.9 GB   ~21 GB left   <- default, and fits the draft too
#   UD-Q2_K_XL   96.8 GB   ~15 GB left
#   UD-IQ3_XXS  104.2 GB    ~8 GB left   <- best quality that still fits alone
#   UD-IQ3_S    116.1 GB   does not fit
#
# Trade up one rung, giving up the draft model to do it:
# MODEL_FILE=UD-IQ3_XXS/DeepSeek-V4-Flash-0731-UD-IQ3_XXS-00001-of-00004.gguf
# NEED_GB=96

# DSpark speculative decoding - the biggest speedup available here, and at
# UD-IQ2_M it fits (90.9 + 10.9 = 101.8 GB). Download the draft once:
#   hf download unsloth/DeepSeek-V4-Flash-0731-GGUF \
#       dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf --local-dir ~/models
# then point at it. up.sh raises its own memory guard to 108 GB when this is set.
# DRAFT_FILE=/home/you/models/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf
# SPEC_N=3

# The startup memory guard. Lower it only if you know what is holding the
# memory and that it will be released.
# NEED_GB=96

# PORT=8891
