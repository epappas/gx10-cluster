# tensorfold-qwen38-flash-next-spark — read by up.sh, exported into the kit.
# Every name here is the KIT's (scripts/config.sh); copy to .env and edit.
# Nothing in this file takes effect until the next `ws up ... restart`, and
# the kit's start.sh re-checks memory and arguments on every start.

# 8901 is this repo's allocation; the kit defaults to 8888 (taken by
# vllm-2node-tp2). Keep it unless you know the other server is down.
PORT=8901

# Match your clients: the 2-node vLLM server here is lowercase.
# SERVED_NAME=qwen3.8-flash-next

# nvfp4 (default): nvidia/Qwen3.8-Flash-Next-FP4-Local, ~96 GiB, needs the
# local image build. int4: azampatti's AutoRound, ~122 GiB, pulls the
# published 1.0.0 image, faster decode, lower capability per its authors.
# CHECKPOINT=int4

# CONTEXT=262144        # native; 1048576 engages auto YaRN x4 (scratch
                        # for a full 1M prompt is not budgeted on one Spark)
# PARALLEL=5            # 1-6; six full 262k windows do not fit the pool
# KV_DTYPE=fp8          # bf16 is exact, costs 1.72x the cache bytes
# DRAFTS=1              # 0 = --no-drafts; acceptance is what spec-decode-accept measures
# THINKING=1
# MAX_TOKENS=32768      # thinking is billed inside it - a 1024 budget here
                        # truncates reasoning-heavy turns (this repo's own gate:
                        # 12/18 at 1024 -> 17/18 at 4096)
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=20
# VISION=1              # 0 returns the vision helper's 2 GiB to the KV budget

# Tuning the kit ships on: MTP depth 6 with a running-product stop rule at
# <=5 streams, prompt-expert tile (+13-15% cold prefill, bit-identical),
# burst admission. Fair prefill costs ~20% of mixed-load time for ~2 s
# short-request waits behind five 100k prompts - opt in deliberately.
# TF_FLASHNEXT_DEPTH=6
# TF_FLASHNEXT_PROMPT_EXPERT_TILE=2
# TF_FLASHNEXT_FILL_FAIR=1
# TF_FLASHNEXT_FILL_LAYERS=2
# TF_FLASHNEXT_FILL_AGING=1024

# The engine keeps this much MemAvailable free while sizing the pool.
# TENSORFOLD_MEMORY_RESERVE_GIB=10

# MEM_CHECK=0           # turn the kit's memory preflight into a warning. The
#                       # preflight exists because exhausting unified memory
#                       # freezes the box; the escape hatch exists for small
#                       # CONTEXT/PARALLEL starts it cannot price. Not for FP4
#                       # at defaults.

# PULL=0                # never pull the published image (offline build)
# DRY_RUN=1             # print the docker command, change nothing - run this first
