# Copy to .env (gitignored). Everything has a working default.

# The model to shard. Default is the 120B NVFP4 already cached on both nodes.
# MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4

# Rendezvous. Auto-detected from the default route; set only if the peers reach
# each other over something other than the management NIC.
# MASTER_ADDR=192.168.1.70
# PEER=poseidon

# Pin the RDMA devices NCCL may use. LEAVE THIS UNSET unless a log shows the
# wrong device chosen - measured here, NCCL discovers both ACTIVE ports on its
# own and skips the two DOWN ones. Pinning by hand is how you end up on one
# rail after a cable moves.
# IB_HCA=rocep1s0f0,roceP2p1s0f0

# 131072 is a deliberate default, not the model's ceiling: KV cache comes out
# of the same unified pool as the weights.
# MAX_MODEL_LEN=131072
# GPU_MEMORY_UTILIZATION=0.80

# The reasoning parser. Defaults to nemotron_v3, which is what the DEFAULT
# model above needs - without it the reasoning trace lands in `content` with
# its `</think>` delimiter intact, and `ws up vllm-quality-gate` fails every
# request on special-token-leak. Set it EMPTY for a model that does not reason,
# or whose parser this vLLM does not carry:
#   REASONING_PARSER=
# The registry, for anything else:
#   docker run --rm --entrypoint python3 vllm/vllm-openai:nightly-aarch64 -c \
#     'from vllm.reasoning import ReasoningParserManager as M; print(sorted(M.list_registered()))'
# REASONING_PARSER=nemotron_v3
