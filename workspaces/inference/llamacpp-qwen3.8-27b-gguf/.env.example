# Copy to .env (gitignored). Defaults below are Qwen3.8 THINKING mode.
#
# INSTRUCT / non-thinking mode wants different sampling - this is a real
# quality difference, not a preference:
# TEMP=0.7
# TOP_P=0.80
# TOP_K=20
#
# 262144 is native. 1M needs YaRN and is not enabled here by default.
# CTX=262144
# PORT=8899
