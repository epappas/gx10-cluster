# Copy to .env (gitignored). Everything has a working default.

# The server to measure. This is a CLIENT - it does not start anything, and it
# coexists with whichever serving workspace is up.
# BASE_URL=http://127.0.0.1:8896/v1

# Only if the server was started with bearer auth (VLLM_API_KEY on the serving
# workspace). Read as API_KEY or VLLM_API_KEY.
# API_KEY=

# Asked of /models by default. Override only when a server lists several.
# MODEL=qwen3.8-flash-next

# Filler size for the needle tasks. The needles are planted at 5/50/95% of it,
# so this is what decides how DEEP the deep one is - and depth is the whole
# probe for a KV-cache quant. Raise it to test where your context actually
# hurts; it costs prefill time on every run.
# CTX_TOKENS=8000   # --ctx-tokens

# Per-reply budget. Reasoning models spend this THINKING first, so an empty
# answer usually means raise it rather than "the quant broke it".
# MAX_TOKENS=2048   # --max-tokens
