# Copy to .env (gitignored) and edit. Every value has a working default.

# What to gate. Default assumes a server on the usual port; the two-node
# workspaces serve from rank 0 on this host, so the same URL reaches them.
# BASE_URL=http://127.0.0.1:8890/v1     # vllm-2node-deepseek-v4-flash

# The SERVED name. Discovered from /v1/models when unset, which is right
# almost always - set it only when the server exposes several models.
# MODEL=deepseek-v4-flash

# The ladder, and how many requests per rung. Rungs are cheap; every rung is
# another chance for a concurrency-only failure to show itself.
# CONCURRENCY=1,2,4
# PER_RUNG=6

# MAX_TOKENS IS A DETECTOR SETTING, NOT A PERFORMANCE ONE. With reasoning
# enabled a budget that runs out before `</think>` arrives makes the parser
# emit neither content nor reasoning: the caller gets "" and is billed for the
# lot. Measured elsewhere on this failure, thinking on at temperature 0.5:
# 256 tokens -> 83% empty, 512 -> 50%, 768 -> 17%, 1024 -> 0/18. So 1024 is
# the floor at which an empty reply means something is actually wrong rather
# than that the budget was too small.
# MAX_TOKENS=1024

# Words of unique filler prepended to every prompt. This has to be long enough
# that the prompt is CHUNK-prefilled rather than swallowed whole, since that is
# where the corruption attaches. Raise it to match your real agent prompts -
# the reported reproducer used ~18k tokens of system prompt and tool schemas.
# PREFILL_WORDS=1800

# TIMEOUT=600
