#!/usr/bin/env python3
"""Cold prefill, measured so that the number means something the next day.

WHAT THIS ANSWERS THAT THE OTHER BENCHES DO NOT. `vllm-bench-serve` measures
throughput under load and `spec-decode-accept` measures the drafter; both are
about DECODE. Prefill is the other half of a request and it is the half a user
feels first - the seconds between pressing enter and the first character. On a
long-context server it dominates: a 100k prompt spends a hundred seconds in
prefill and then decodes at full speed, and no decode benchmark will ever show
you that.

THE ONE THING THAT MAKES OR BREAKS A PREFILL NUMBER. Prefix caching is on for
every serving workspace here, so the second time you send a prompt it is not a
prefill at all - it is a cache hit wearing a prefill's clothes. Measured on the
kit this was ported from: rerunning a "cold" ladder without changing the prompt
took TTFT from 10.3 s to 1.9 s, a 5x speedup that is entirely an artefact of
the measurement. A prefill bench that does not defeat its own cache does not
report prefill.

So every cold prompt starts with a unique salt - a fresh UUID plus random pad,
FIRST in the message, before a single token of shared text - and the tool then
CHECKS that the server agrees, by reading the prefix-cache hit counter across
each request. There is no reset to fall back on: these images expose no
`/reset_prefix_cache`, so salting is not a convenience, it is the only
mechanism available. The chat template's own few shared tokens ahead of the
salt are far below one page and hit nothing. A cold rung that reports any hits is reported as invalid rather
than as a fast result. That check is the reason to use this instead of curl and
a stopwatch.

WHAT IT MEASURES, per rung:

  TTFT          request start to the first CONTENT token, off the stream
  prompt_tokens from the server's own `usage`, never an estimate
  prefill tok/s prompt_tokens / TTFT
  hits/compute  deltas of the prefix-cache and prompt-token-source counters

and then one follow-up turn that is DELIBERATELY not cold, to measure reuse.

THE PAGE MODEL, which is why the reuse row is a ratio and not a percentage.
Prefix-cache hits are BLOCK-ALIGNED: a conversation of 7.7k tokens does not
reuse 7.7k tokens, it reuses floor(7717/3584) * 3584 = 7168 of them, and the
uncached remainder is real compute every turn. Reporting "93% hit" invites the
conclusion that something is losing 7%; reporting hit_efficiency = measured /
page-model expectation says the useful thing instead - 1.0 means the server is
reusing everything the page model allows, and anything else means the page size
assumed here is not the page size this server uses. When they disagree the page
sizes CONSISTENT with what was observed are printed - a set rather than a
guess, because one measurement genuinely cannot pick between them.

  ws up vllm-prefill-ladder
  BASE_URL=http://127.0.0.1:8893/v1 ws up vllm-prefill-ladder
  ws up vllm-prefill-ladder --rungs 8000,12000,16000,100000   # long rungs cost minutes
  ws up vllm-prefill-ladder --chunk-tokens 2048               # also report s/chunk

Exit status is non-zero when a rung was invalid - not when it was slow.

Ported from the cold-prefill protocol in
MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks (docs/cold-prefill.md,
docs/improve-prefill.md). The protocol is theirs; the verdicts are this repo's.
"""
from __future__ import annotations

import argparse
import json
import os
import secrets
import statistics
import sys
import time
import urllib.request
import uuid

# The default page for the sparse-MLA hybrid this was written against. It is a
# SERVER property, not a universal one, so it is a flag: a dense model on the
# same host aligns on its own block size and this default would then be wrong
# in a way the hit_efficiency row makes obvious rather than hides.
DEFAULT_PAGE_TOKENS = 3584

# "the " is roughly one token on every tokenizer this repo serves, which makes
# the calibration converge in one correction step instead of bisecting.
FILLER = "the "
TASK = "Reply with OK."
FOLLOW_UP = "Confirm with OK."


def _url(base: str, path: str) -> str:
    return base.rstrip("/") + path


def _root(base: str) -> str:
    # /metrics and /tokenize are served off the ROOT, not off /v1, and BASE_URL
    # in this repo points at /v1 because that is what a client needs.
    root = base.rstrip("/")
    return root[: -len("/v1")] if root.endswith("/v1") else root


def die(msg: str):
    print(f"prefill-ladder: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _headers() -> dict[str, str]:
    h = {"Content-Type": "application/json"}
    key = os.environ.get("API_KEY") or os.environ.get("VLLM_API_KEY")
    if key:
        h["Authorization"] = f"Bearer {key}"
    return h


def _post(url: str, body: dict, timeout: float):
    req = urllib.request.Request(
        url, data=json.dumps(body).encode(), headers=_headers(), method="POST"
    )
    return urllib.request.urlopen(req, timeout=timeout)


def _get(url: str, timeout: float) -> str:
    req = urllib.request.Request(url, headers=_headers())
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def discover_model(base: str, timeout: float) -> str:
    try:
        return json.loads(_get(_url(base, "/models"), timeout))["data"][0]["id"]
    except Exception as exc:
        die(f"cannot read {_url(base, '/models')}: {exc}\n"
            f"  is the server up? set BASE_URL, or MODEL to skip discovery")
        raise  # unreachable


def parse_metrics(raw: str) -> dict[str, float]:
    """The five counters this bench reads, summed across label sets.

    A PURE FUNCTION over Prometheus text, so `make prefill-ladder` exercises it
    with no server. It is the half of this tool that can be wrong without
    looking wrong: if the names drift, every rung reports zero hits, which is
    exactly what a correctly-cold rung reports - so a broken parser would make
    a contaminated run look valid. That is a wrong answer wearing the costume
    of a clean one, which is the failure this repo tests for by default.
    """
    wanted = {
        "vllm:prefix_cache_hits_total": "hits",
        "vllm:prefix_cache_queries_total": "queries",
        "vllm:prompt_tokens_total": "prompt_tokens",
        "vllm:num_requests_running": "running",
        "vllm:gpu_cache_usage_perc": "gpu_cache_usage_perc",
    }
    out: dict[str, float] = {}
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        head, _, val = line.rpartition(" ")
        name, _, labels = head.partition("{")
        try:
            v = float(val)
        except ValueError:
            continue
        key = wanted.get(name)
        if key is None and name == "vllm:prompt_tokens_by_source_total":
            if 'source="local_compute"' in labels:
                key = "local_compute"
            elif 'source="local_cache_hit"' in labels:
                key = "local_cache_hit"
        if key is None:
            continue
        # `running` and the usage gauge are levels, not counters: summing two
        # label sets would report a number no engine ever had. Everything else
        # is a counter and summing across engines is the right total.
        if key in ("running", "gpu_cache_usage_perc"):
            out[key] = max(out.get(key, 0.0), v)
        else:
            out[key] = out.get(key, 0.0) + v
    return out


def snapshot(base: str, timeout: float) -> dict[str, float]:
    try:
        return parse_metrics(_get(_root(base) + "/metrics", timeout))
    except Exception as exc:
        die(f"cannot read {_root(base)}/metrics: {exc}\n"
            f"  without it a cold rung cannot be PROVEN cold - refusing to guess")
        raise  # unreachable


def page_expectation(shared_tokens: int, page: int) -> int:
    """Hit tokens the block-aligned page model allows for a shared prefix."""
    if page <= 0:
        raise ValueError("page must be positive")
    return (max(shared_tokens, 0) // page) * page


def hit_efficiency(hits: int, shared_tokens: int, page: int) -> float | None:
    """measured / page-model expectation. 1.0 = reusing everything allowed.

    None when the model allows nothing - a conversation shorter than one page
    legitimately reuses zero, and dividing by that would manufacture a failure
    out of a prompt that was simply too short to test with.
    """
    expected = page_expectation(shared_tokens, page)
    if expected == 0:
        return None
    return hits / expected


def page_candidates(hits: int, shared_tokens: int, limit: int = 6) -> list[int]:
    """Page sizes consistent with one observation of (hits, shared).

    A SET, not a point estimate, and that is the honest shape. hits ==
    floor(shared/page) * page constrains the page two ways - it must divide
    hits, and it must exceed the uncached remainder shared-hits - but one
    sample cannot pick between the survivors: 7168 hits on an 8004-token
    prompt is equally consistent with a 3584-token page and a 896-token one.
    Naming a single number here would be a guess presented as a measurement,
    and the caller is about to tell somebody their page size is wrong.

    Returned smallest first, capped, because the small end is the tight bound.
    """
    if hits <= 0 or shared_tokens <= 0 or hits > shared_tokens:
        return []
    remainder = shared_tokens - hits
    out = [d for d in sorted(_divisors(hits))
           if d > remainder and page_expectation(shared_tokens, d) == hits]
    return out[:limit]


def _divisors(n: int) -> list[int]:
    out, d = [], 1
    while d * d <= n:
        if n % d == 0:
            out.append(d)
            if d != n // d:
                out.append(n // d)
        d += 1
    return out


def unique_salt() -> str:
    """Fresh per cold request, and FIRST in the message.

    Position is the whole point. Prefix caching hashes a PREFIX: salt appended
    at the end shares every preceding block with the last run and the request
    is cold in name only. Ahead of the shared text, the very first block
    differs and nothing after it can match.
    """
    return f"COLD-PREFILL salt={uuid.uuid4()} pad={secrets.token_hex(24)}"


def build_user_text(n_filler: int, salt: str) -> str:
    return f"{salt}\n{FILLER * n_filler}\n{TASK}"


def tokenize(base: str, model: str, messages: list[dict], timeout: float) -> int:
    """Prompt length in tokens, from the server's own tokenizer.

    THE SCHEMA IS NOT UNIVERSAL, and this workspace says `engine: any`. vLLM's
    /tokenize answers a chat body with {"count": N, "tokens": [...]}. llama.cpp
    serves the same PATH with a different contract - it wants {"content": ...}
    and returns {"tokens": [...]} - so a vLLM-shaped request there is answered
    200 OK with an EMPTY token list.

    That empty list is the case worth being careful about. Reading len(tokens)
    unconditionally would take 0 as the prompt overhead, calibrate every rung
    against a length nobody measured, and print a tok/s table that looks
    entirely normal. A wrong number here is worse than no number, so an empty
    answer to a non-empty prompt is treated as "this server does not implement
    the endpoint this tool needs" and said out loud.
    """
    with _post(_root(base) + "/tokenize", {"model": model, "messages": messages},
               timeout) as r:
        doc = json.loads(r.read().decode())
    if isinstance(doc, dict):
        if isinstance(doc.get("count"), int):
            return int(doc["count"])
        toks = doc.get("tokens")
        if isinstance(toks, list) and toks:
            return len(toks)
    die("this server's /tokenize does not answer a chat body the way vLLM does "
        f"(got {json.dumps(doc)[:120]}).\n"
        "  The ladder sizes every rung with it, so without it there is no rung -\n"
        "  a prefill number against an unknown prompt length is not a measurement.\n"
        "  llama.cpp is the common case: it serves /tokenize for {\"content\": ...}\n"
        "  only, and answers a chat body with an empty list.")


def calibrate(base: str, model: str, target: int, salt: str,
              timeout: float) -> tuple[int, int]:
    """Choose a filler count so the prompt lands on `target` tokens.

    Via /tokenize, and then verified against the server's own `usage` after the
    request. Sizing by characters instead is the common shortcut and it makes
    every rung a slightly different amount of work, which turns a tok/s
    comparison between two configurations into a comparison between two prompt
    lengths.
    """
    overhead = tokenize(base, model, [{"role": "user",
                                       "content": build_user_text(0, salt)}], timeout)
    n = max(target - overhead, 1)
    got = tokenize(base, model, [{"role": "user",
                                  "content": build_user_text(n, salt)}], timeout)
    if got > 0 and abs(got - target) / target > 0.005:
        per = (got - overhead) / n if n else 1.0
        n = max(int(round((target - overhead) / max(per, 0.1))), 1)
        got = tokenize(base, model, [{"role": "user",
                                      "content": build_user_text(n, salt)}], timeout)
    return n, got


def stream_once(base: str, model: str, messages: list[dict],
                timeout: float) -> dict:
    """One request. TTFT to the first CONTENT token; token counts from usage.

    max_tokens is 8 because this measures PREFILL. Thinking is off, and it is
    off via a TOP-LEVEL chat_template_kwargs rather than a nested extra_body -
    which is the shape the GLM-family servers here accept, and the shape people
    get wrong. With thinking on, the first chunk to arrive is reasoning, and a
    TTFT taken from "first chunk" would then be timing the wrong thing.
    """
    body = {
        "model": model,
        "messages": messages,
        "max_tokens": 8,
        "temperature": 0,
        "stream": True,
        "stream_options": {"include_usage": True},
        "chat_template_kwargs": {"enable_thinking": False},
    }
    t0 = time.perf_counter()
    ttft = None
    usage: dict = {}
    text: list[str] = []
    finish = None
    with _post(_url(base, "/chat/completions"), body, timeout) as resp:
        for raw in resp:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            payload = line[5:].strip()
            if payload == "[DONE]":
                break
            try:
                chunk = json.loads(payload)
            except json.JSONDecodeError:
                continue
            if chunk.get("usage"):
                usage = chunk["usage"]
            for choice in chunk.get("choices") or []:
                if choice.get("finish_reason"):
                    finish = choice["finish_reason"]
                piece = (choice.get("delta") or {}).get("content")
                if piece:
                    if ttft is None:
                        ttft = time.perf_counter() - t0
                    text.append(piece)
    return {
        "ttft": ttft,
        "wall": time.perf_counter() - t0,
        "prompt_tokens": int(usage.get("prompt_tokens") or 0),
        "completion_tokens": int(usage.get("completion_tokens") or 0),
        "finish": finish,
        "text": "".join(text).strip(),
    }


def run_request(base: str, model: str, messages: list[dict],
                timeout: float) -> dict:
    """One request bracketed by metrics reads, so hits are attributable."""
    before = snapshot(base, timeout=30)
    res = stream_once(base, model, messages, timeout)
    after = snapshot(base, timeout=30)
    res["hits"] = int(after.get("hits", 0) - before.get("hits", 0))
    res["queries"] = int(after.get("queries", 0) - before.get("queries", 0))
    res["compute"] = int(after.get("local_compute", 0) - before.get("local_compute", 0))
    res["running_before"] = before.get("running", 0.0)
    return res


def rate(res: dict) -> float | None:
    if not res.get("ttft") or not res.get("prompt_tokens"):
        return None
    return res["prompt_tokens"] / res["ttft"]


def verdict(rungs: list[dict], apc: dict | None, page: int,
            tolerance: float) -> list[tuple[str, str]]:
    """Everything that makes a number in this report not mean what it says.

    Pure, and tested offline, for the same reason the parser is: the failures
    here are all cases where the run LOOKS fine. A contaminated cold rung is
    simply fast. A miscalibrated one is simply a different number. Neither
    raises anything on its own.
    """
    out: list[tuple[str, str]] = []

    contaminated = [r for r in rungs if r.get("hits", 0) > 0]
    if contaminated:
        names = ", ".join(r["label"] for r in contaminated)
        out.append(("INVALID", (
            f"{len(contaminated)} 'cold' rung(s) hit the prefix cache: {names}. "
            "Those tok/s figures are cache reuse, not prefill. The salt did not "
            "defeat the cache - check that nothing else is replaying this "
            "prompt, and that BASE_URL points where you think it does")))

    drifted = [
        r for r in rungs
        if r.get("target") and r.get("prompt_tokens")
        and abs(r["prompt_tokens"] - r["target"]) / r["target"] > tolerance
    ]
    if drifted:
        names = ", ".join(
            f"{r['label']} ({r['prompt_tokens']} vs {r['target']})" for r in drifted)
        out.append(("INVALID", (
            f"prompt size missed its target beyond {tolerance:.1%}: {names}. "
            "The rung measured a different amount of work than its label claims, "
            "so it is not comparable to another run of the same ladder")))

    busy = [r for r in rungs if r.get("running_before", 0) > 0]
    if busy:
        out.append(("WARN", (
            f"{len(busy)} rung(s) started while the server was already running a "
            "request. Prefill numbers assume the box is otherwise idle; anything "
            "measured alongside another prefill is a queueing measurement")))

    if all(r.get("queries", 0) == 0 for r in rungs) and rungs:
        out.append(("NOTE", (
            "the prefix-cache counters never moved - this server looks like it "
            "is running without --enable-prefix-caching. The cold rungs are "
            "still valid; the reuse row below cannot say anything")))
    elif apc:
        # Recomputed here rather than read off the dict the caller built. The
        # verdicts are the tested half of this tool, and a pure function that
        # depends on a field somebody else remembered to set is not one.
        eff = hit_efficiency(apc.get("hits", 0), apc.get("shared", 0), page)
        if eff is None:
            out.append(("NOTE", (
                "the follow-up turn was shorter than one page, so the page model "
                "allows zero reuse and there is nothing to check. Raise the "
                "smallest rung above the page size to exercise it")))
        elif eff < 0.98:
            cands = [c for c in page_candidates(apc.get("hits", 0), apc.get("shared", 0))
                     if c != page]
            extra = (" - the hits are consistent with a page of "
                     + " or ".join(str(c) for c in cands)
                     + f" tokens rather than {page}") if cands else ""
            out.append(("WARN", (
                f"reuse efficiency {eff:.2f}: the follow-up turn reused less than "
                f"the {page}-token page model allows{extra}")))
        elif eff > 1.02:
            out.append(("NOTE", (
                f"reuse efficiency {eff:.2f} is above 1.0, so this server aligns "
                f"FINER than the {page}-token page assumed here - pass --page to "
                "get an honest ratio")))

    bad = [r for r in rungs + ([apc] if apc else [])
           if r.get("text") and r["text"].upper().rstrip(".") != "OK"]
    if bad:
        out.append(("WARN", (
            f"{len(bad)} request(s) did not answer 'OK'. The timing is still "
            "valid, but a server that ignores a two-word instruction is worth a "
            "look with `ws up vllm-quality-gate`")))
    return out


def report(rungs: list[dict], apc: dict | None, page: int,
           chunk_tokens: int | None) -> None:
    print()
    head = f"{'rung':>8}  {'prompt tok':>10}  {'TTFT s':>8}  {'tok/s':>7}  {'hits':>7}  {'compute':>8}"
    if chunk_tokens:
        head += f"  {'s/chunk':>7}"
    print(head)
    print("  " + "-" * (len(head) - 2))
    for r in rungs:
        tps = rate(r)
        line = (f"{r['label']:>8}  {r['prompt_tokens']:>10}  "
                f"{(r['ttft'] or 0):>8.2f}  {(tps or 0):>7.0f}  "
                f"{r['hits']:>7}  {r['compute']:>8}")
        if chunk_tokens:
            chunks = max(1, -(-r["prompt_tokens"] // chunk_tokens))
            line += f"  {(r['ttft'] or 0) / chunks:>7.3f}"
        print(line)

    if apc:
        tps = rate(apc)
        eff = apc.get("efficiency")
        print(f"{'follow-up':>8}  {apc['prompt_tokens']:>10}  {(apc['ttft'] or 0):>8.2f}  "
              f"{(tps or 0):>7.0f}  {apc['hits']:>7}  {apc['compute']:>8}")
        exp = page_expectation(apc.get("shared", 0), page)
        print(f"\n  reuse: {apc['hits']} of {exp} allowed by a {page}-token page "
              f"({'n/a' if eff is None else f'{eff:.2f}'} efficiency), "
              f"{apc['compute']} tokens still computed")

    if chunk_tokens:
        print(f"\n  s/chunk is the number to A/B when tuning --max-num-batched-tokens:")
        print(f"  it is flat across rungs when prefill is compute-bound, and the")
        print(f"  chunk count - not the per-chunk cost - is what a bigger chunk buys.")

    rates = [r for r in (rate(x) for x in rungs) if r]
    if len(rates) >= 2:
        print(f"\n  {min(rates):.0f}-{max(rates):.0f} tok/s across the ladder "
              f"(median {statistics.median(rates):.0f}). Short rungs are SLOWER on")
        print("  purpose: tokenize, template and hashing are per-request costs that")
        print("  amortise badly below ~12k, and that is the TTFT a new chat feels.")


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Cold prefill throughput and prefix-cache reuse, proven cold.")
    ap.add_argument("--base-url",
                    default=os.environ.get("BASE_URL", "http://127.0.0.1:8888/v1"))
    ap.add_argument("--model", default=os.environ.get("MODEL") or None)
    ap.add_argument("--rungs", default=os.environ.get("RUNGS", "8000,12000,16000"),
                    help="target prompt_tokens, comma separated. Long rungs cost "
                         "MINUTES each: 100k is ~100 s of prefill, 300k is ~5 min")
    ap.add_argument("--page", type=int,
                    default=int(os.environ.get("PAGE_TOKENS", DEFAULT_PAGE_TOKENS)),
                    help="prefix-cache page for the reuse expectation")
    ap.add_argument("--chunk-tokens", type=int,
                    default=int(os.environ.get("MAX_NUM_BATCHED_TOKENS", "0")) or None,
                    help="the server's --max-num-batched-tokens; adds an s/chunk column")
    ap.add_argument("--tolerance", type=float, default=0.02,
                    help="how far prompt_tokens may miss its target and still count")
    ap.add_argument("--no-apc", action="store_true",
                    help="skip the follow-up turn that measures reuse")
    ap.add_argument("--timeout", type=float,
                    default=float(os.environ.get("TIMEOUT", "1200")))
    ap.add_argument("--json", dest="as_json", metavar="PATH",
                    default=os.environ.get("JSON_OUT") or None)
    args = ap.parse_args()

    try:
        targets = [int(x) for x in args.rungs.split(",") if x.strip()]
    except ValueError:
        die(f"--rungs must be integers: {args.rungs!r}")
    if not targets:
        die("--rungs is empty")
    if min(targets) < 1:
        die("--rungs must be positive token counts")
    if args.page < 1:
        die("--page must be a positive token count")

    base = args.base_url
    model = args.model or discover_model(base, 30)

    print(f"prefill ladder   {base}   model={model}")
    print("  every cold prompt is salted FIRST, and the prefix-cache counter is")
    print("  read across each request to PROVE the rung was cold")
    if max(targets) >= 100_000:
        print(f"  the {max(targets)}-token rung alone is minutes of prefill - this is not quick")

    rungs: list[dict] = []
    apc: dict | None = None
    for target in targets:
        salt = unique_salt()
        n, expect = calibrate(base, model, target, salt, timeout=180)
        label = f"{target // 1000}k" if target >= 1000 else str(target)
        print(f"  {label:>6}  calibrated to {expect} tokens, sending...", flush=True)
        res = run_request(
            base, model,
            [{"role": "user", "content": build_user_text(n, salt)}],
            args.timeout)
        res["label"], res["target"] = label, target
        rungs.append(res)

        # ONE follow-up, on the SMALLEST rung, and deliberately not cold. It is
        # the shape a chat client actually produces: the whole history resent
        # with one more turn on the end, which is where prefix caching either
        # earns its keep or does not.
        if not args.no_apc and apc is None and target == min(targets):
            history = [
                {"role": "user", "content": build_user_text(n, salt)},
                {"role": "assistant", "content": res["text"] or "OK"},
                {"role": "user", "content": FOLLOW_UP},
            ]
            print(f"  {'reuse':>6}  same history plus one turn...", flush=True)
            apc = run_request(base, model, history, args.timeout)
            # The shared prefix is the first turn - what the server could reuse.
            apc["shared"] = res["prompt_tokens"]
            apc["efficiency"] = hit_efficiency(apc["hits"], apc["shared"], args.page)
            apc["label"] = "follow-up"

    report(rungs, apc, args.page, args.chunk_tokens)

    findings = verdict(rungs, apc, args.page, args.tolerance)
    print()
    if not findings:
        print("  every rung was cold, on target and idle - the numbers above compare")
    for level, msg in findings:
        print(f"  {level}: {msg}")

    if args.as_json:
        with open(args.as_json, "w", encoding="utf-8") as fh:
            json.dump({"rungs": rungs, "follow_up": apc, "page": args.page,
                       "findings": findings}, fh, indent=2)
        print(f"\n  wrote {args.as_json}")

    return 1 if any(level == "INVALID" for level, _ in findings) else 0


if __name__ == "__main__":
    sys.exit(main())
