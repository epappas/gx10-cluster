# Copy to .env (gitignored) and edit. Every value has a working default.

# What to bench. Default assumes vllm-qwen3.8-27b-nvfp4 on its usual port.
# BASE_URL=http://127.0.0.1:8888/v1

# Bench the TWO-NODE server instead - same URL, it serves from rank 0:
# BASE_URL=http://127.0.0.1:8888/v1

# MODEL is the SERVED name (what goes in the request body) and is discovered
# from /v1/models. TOKENIZER is the HF repo id and defaults to MODEL, which is
# wrong whenever the server was started with --served-model-name: the bench
# then tries to fetch a repo called 'qwen3.8-27b' and dies with a 404 several
# minutes in. Set it when they differ.
# MODEL=qwen3.8-27b
# TOKENIZER=unsloth/Qwen3.8-27B-NVFP4

# The ladder. Each rung is a separate `vllm bench serve` run.
# CONCURRENCY=1,2,4,8,16,32

# Requests per stream per rung. num_prompts = concurrency * this, so every rung
# runs the same amount of work per stream and the column compares honestly.
# Raise it for a steadier number, at linear cost in wall-clock.
# PROMPTS_PER_STREAM=8

# Shape of the synthetic requests. 1024/128 is a chat-ish default. For a
# prefill-bound picture try 8192/128; for decode-bound, 128/2048.
# INPUT_LEN=1024
# OUTPUT_LEN=128

# `vllm` hits /v1/completions, `openai-chat` hits /v1/chat/completions. Use the
# chat backend if the server exposes only the chat route, or if you want the
# chat template included in what is measured.
# BACKEND=vllm

# Run the bench from a host install instead of the container. Faster to start
# and one less image, but the host vllm version then differs from the server's.
# BENCH_LOCAL=1

# RESULT_DIR=~/.local/state/gx10-bench
# INTERVAL=1
