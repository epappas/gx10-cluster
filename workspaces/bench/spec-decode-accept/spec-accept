#!/usr/bin/env python3
"""Is the speculative decoder actually working - and if not, WHERE does it fail.

THE FAILURE THIS EXISTS FOR. A broken draft path costs acceptance and NOTHING
ELSE. The target model still verifies every token, so the output stays
perfectly correct; you just get half the speed. There is no error, no warning,
and no wrong answer to notice. It reads as bad hardware or a bad recipe, and it
sends people to rewrite flags that were never the problem.

`vllm-bench-serve` already shows aggregate acceptance live, which answers "is
the drafter working at all". This answers the harder question: acceptance BY
DRAFT POSITION, which is the only view that separates the two ways a drafter
can be broken.

  a weak drafter    every position is low, and the curve falls smoothly
  a broken MASK     position 0 is HEALTHY and 1..k-1 collapse

The second shape is what a causal attention mask inside a non-causal draft
block produces: the first drafted token is predicted from real context and is
fine, and every later one is predicted from a block it is not allowed to see.
Aggregate acceptance halves. Nothing else moves. Measured on the GLM-5.3-Flash
kit this was ported from, pinning the draft backend to TRITON_ATTN took
structured decode from ~62 to ~29 tok/s at 0.31 aggregate acceptance, with
position 0 healthy and the later positions collapsed.

THE PROMPT CLASS IS NOT A FLAVOUR, IT IS WHAT MAKES THE SHAPE READABLE.
Acceptance is a property of the TEXT: a drafter predicts "the next number in a
list" almost perfectly and free-form prose barely better than chance. Published
healthy medians on that kit, both from the SAME working server:

  structured   0.98  0.98  0.94  0.94  0.91  0.83  0.83     aggregate 0.92
  prose        0.75  0.58  0.41  0.28  0.16  0.09  0.06     aggregate 0.33

A steep collapse toward zero is therefore NORMAL on prose and is only evidence
of anything on structured output, where a healthy ladder stays above ~0.8 the
whole way out. That is why this runs the structured class by default, names the
class in every result, and refuses to convict a mask on a prose ladder -
condemning a healthy server is the failure that gets a check muted.

WHY COMPLETION TOKENS COME FROM `usage`, NOT FROM COUNTING DELTAS. Under
speculative decoding a server emits at most one SSE chunk per decode STEP,
carrying every token accepted in that step. Counting streamed deltas therefore
measures steps per second and under-reports by exactly the acceptance length -
which is the number this tool exists to measure, so getting it wrong here would
be self-concealing. Streaming is still used, but only for the first-token
timestamp; the token count comes from `usage.completion_tokens`.

TWO ENGINES, AND ONLY ONE OF THEM CAN BE CONVICTED. vLLM publishes
`vllm:spec_decode_num_accepted_tokens_per_pos_total`, which is the whole basis
of the ladder above. SGLang publishes NO per-position counter at all - the best
it offers is an EMA of accept LENGTH on /server_info. So on an SGLang server
this tool degrades honestly: it reports accept length, derives the comparable
acceptance ratio from it, and says plainly that the shape which separates a
weak drafter from a broken mask is not visible here. It does NOT guess.

That degradation is the point rather than an apology. A length-only reading
still separates "the drafter is doing something" from "the drafter is doing
nothing", which is the failure that costs half the speed silently. For the
ladder, serve the same checkpoint under vLLM - which for Nemotron 3.5 Lightning
is exactly why this repo carries both workspaces.

  ws up spec-decode-accept
  BASE_URL=http://127.0.0.1:8893/v1 ws up spec-decode-accept
  ws up spec-decode-accept --class prose --runs 3

Exit status is 0 unless the server has no speculative decoding configured or
did not answer.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import textwrap
import time
import urllib.error
import urllib.request

# vllm:spec_decode_num_accepted_tokens_per_pos_total{position="3"} 1234
SPEC_RE = re.compile(r"^(vllm:spec_decode_[a-zA-Z0-9_]+)(?:\{([^}]*)\})?\s+(\S+)$")
POS_RE = re.compile(r'position="(\d+)"')

# sglang:spec_num_draft_tokens{model_name="m"} 4.0
#
# A DIFFERENT KIND OF METRIC, and reading it as a counter is the trap. SGLang's
# spec metrics are GAUGES of the currently active configuration - "the verify
# window is 4" - not cumulative counts of what was drafted and accepted. There
# is no per-position counter and no accepted-tokens counter to take a delta of,
# which is why the SGLang path reads accept length off /server_info instead of
# subtracting two metric snapshots.
SGL_RE = re.compile(r"^(sglang:[a-zA-Z0-9_]+)(?:\{([^}]*)\})?\s+(\S+)$")

# Deliberately two very different regimes. See the module docstring: a single
# prompt class produces a number nobody can interpret without the other one.
PROMPTS = {
    "structured": (
        "Count from 1 to 200. Output only the numbers, separated by spaces. "
        "No other text."
    ),
    "prose": (
        "Write a detailed step-by-step explanation of how a hash map works, "
        "including collision handling, resizing, and time complexity. "
        "Be thorough."
    ),
}


def _url(base: str, path: str) -> str:
    return base.rstrip("/") + path


def _metrics_url(base: str) -> str:
    # /metrics is served off the ROOT, not off /v1, and BASE_URL in this repo
    # points at /v1 because that is what a client needs.
    root = base.rstrip("/")
    return (root[: -len("/v1")] if root.endswith("/v1") else root) + "/metrics"


def die(msg: str):
    print(f"spec-accept: {msg}", file=sys.stderr)
    raise SystemExit(1)


def discover_model(base: str, timeout: float) -> str:
    """Ask the server what it serves rather than making the caller repeat it."""
    try:
        with urllib.request.urlopen(_url(base, "/models"), timeout=timeout) as r:
            data = json.load(r)
        return data["data"][0]["id"]
    except Exception as exc:  # any failure here earns the same advice
        die(f"cannot read {_url(base, '/models')}: {exc}\n"
            f"  is the server up? set BASE_URL, or MODEL to skip discovery")
        raise  # unreachable; die() exits


def parse_metrics(raw: str) -> dict[str, float]:
    """Every vllm:spec_decode_* counter, with per-position ones keyed pos:N.

    Counters are summed across label sets other than `position`, because a
    server that exposes them per engine or per model would otherwise report
    only whichever line happened to be last.

    Kept a PURE FUNCTION over text so `make check` can exercise it offline. A
    parser that has quietly stopped recognising the metric names reports zero
    drafts, which this tool would then present as "speculative decoding is off"
    - a wrong answer that looks like a finding.
    """
    out: dict[str, float] = {}
    for line in raw.splitlines():
        m = SPEC_RE.match(line)
        if not m:
            continue
        name, labels, val = m.group(1), m.group(2) or "", m.group(3)
        if name.endswith("_created"):
            continue
        try:
            v = float(val)
        except ValueError:
            continue
        pos = POS_RE.search(labels) if "per_pos" in name else None
        key = f"pos:{pos.group(1)}" if pos else name
        out[key] = out.get(key, 0.0) + v
    return out


def parse_sglang_metrics(raw: str) -> dict[str, float]:
    """The `sglang:` half, kept a pure function for the same reason.

    Only two of these matter and neither is a counter: `spec_num_draft_tokens`
    is the verify window and `spec_num_steps` is the draft depth, both gauges
    of the live configuration. Their PRESENCE is the useful signal - it says a
    speculator is configured at all, which is what separates "measure the
    length" from "there is nothing to measure".
    """
    out: dict[str, float] = {}
    for line in raw.splitlines():
        m = SGL_RE.match(line)
        if not m:
            continue
        name, val = m.group(1), m.group(3)
        if name.endswith("_created"):
            continue
        try:
            out[name] = float(val)
        except ValueError:
            continue
    return out


def accept_length(info: dict) -> float | None:
    """The EMA of accepted tokens per verify step, from /server_info.

    Searched by SUBSTRING rather than by an exact key. The field has been
    spelled `avg_spec_accept_length` and `spec_accept_length` across versions,
    and a probe that returns "no speculative decoding" because a key was
    renamed is exactly the wrong answer wearing the costume of a finding -
    which is the failure this whole tool exists to avoid making itself.
    """
    st = (info.get("internal_states") or [{}])[0]
    for key, val in st.items():
        if "accept_length" in key and isinstance(val, (int, float)):
            return float(val)
    return None


def server_info(base: str, timeout: float) -> dict:
    """SGLang's /server_info, with the deprecated alias as a fallback.

    /get_server_info is deprecated upstream but still present, and still what
    every published recipe calls - so both are tried and neither is fatal. An
    empty dict here means "not an SGLang server", which is the normal case.
    """
    root = base.rstrip("/")
    root = root[: -len("/v1")] if root.endswith("/v1") else root
    for path in ("/server_info", "/get_server_info"):
        try:
            with urllib.request.urlopen(root + path, timeout=timeout) as r:
                return json.load(r)
        except Exception:
            continue
    return {}


def fetch_metrics(base: str, timeout: float) -> str:
    try:
        with urllib.request.urlopen(_metrics_url(base), timeout=timeout) as r:
            return r.read().decode("utf-8", "replace")
    except Exception as exc:
        die(f"cannot read {_metrics_url(base)}: {exc}\n"
            f"  vLLM serves /metrics by default; SGLang needs --enable-metrics")
        raise  # unreachable; die() exits


def snapshot(base: str, timeout: float) -> dict[str, float]:
    return parse_metrics(fetch_metrics(base, timeout))


def detect_engine(base: str, timeout: float) -> str:
    """`vllm`, `sglang`, or `none` - decided by what the server publishes.

    Asked once, before any generation, because the answer changes what can be
    MEASURED and therefore what may be CONCLUDED. Guessing from the port or the
    model id would eventually read an SGLang server as a vLLM one with an empty
    ladder, and print "position 0 collapsed" about a server that simply does
    not count positions.
    """
    raw = fetch_metrics(base, timeout)
    if any(k.startswith("vllm:spec_decode_") for k in parse_metrics(raw)):
        return "vllm"
    if parse_sglang_metrics(raw) or server_info(base, timeout):
        return "sglang"
    # vLLM exposes the spec_decode family only when a drafter is configured, so
    # an otherwise-healthy vLLM server with no speculator lands here too. That
    # is the right answer: there is nothing to measure either way.
    return "none"


def stream_once(base: str, model: str, prompt: str, max_tokens: int,
                timeout: float) -> dict:
    """One generation. TTFT from the stream, token count from `usage`."""
    body = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        # Temperature 0 so the comparison between runs is about the drafter and
        # not about sampling luck.
        "temperature": 0,
        "top_p": 1,
        "max_tokens": max_tokens,
        "stream": True,
        "stream_options": {"include_usage": True},
        # Thinking off. With it on, most of the generation is reasoning and the
        # acceptance you measure is the acceptance of a different text class
        # than the one you named.
        "chat_template_kwargs": {"enable_thinking": False},
    }
    req = urllib.request.Request(
        _url(base, "/chat/completions"),
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    t0 = time.perf_counter()
    first = None
    usage = None
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            buf = b""
            while True:
                piece = resp.read(512)
                if not piece:
                    break
                buf += piece
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    line = line.strip()
                    if not line.startswith(b"data:"):
                        continue
                    payload = line[5:].strip()
                    if payload == b"[DONE]":
                        continue
                    try:
                        obj = json.loads(payload)
                    except json.JSONDecodeError:
                        continue
                    if obj.get("usage"):
                        usage = obj["usage"]
                    for ch in obj.get("choices") or []:
                        delta = ch.get("delta") or {}
                        # `reasoning` OR `reasoning_content`: this family of
                        # runtimes returns the first and OpenAI-compatible
                        # clients expect the second.
                        if (delta.get("content") or delta.get("reasoning")
                                or delta.get("reasoning_content")):
                            if first is None:
                                first = time.perf_counter()
    except urllib.error.HTTPError as exc:
        die(f"HTTP {exc.code} from the server: {exc.read().decode('utf-8', 'replace')[:400]}")
    except Exception as exc:
        die(f"request failed: {exc}")

    t1 = time.perf_counter()
    completed = int((usage or {}).get("completion_tokens") or 0)
    # The first token's time is not decode time - it is prefill. Decode rate is
    # the remaining tokens over the time after the first one arrived.
    decode_s = None if first is None else (t1 - first)
    tok_s = None
    if decode_s and decode_s > 0 and completed > 1:
        tok_s = (completed - 1) / decode_s
    return {
        "ttft_s": None if first is None else first - t0,
        "tok_s": tok_s,
        "completion_tokens": completed,
    }


def median(xs: list) -> float | None:
    xs = sorted(x for x in xs if x is not None)
    if not xs:
        return None
    mid = len(xs) // 2
    return xs[mid] if len(xs) % 2 else (xs[mid - 1] + xs[mid]) / 2


def bar(frac: float, width: int = 20) -> str:
    filled = max(0, min(width, round(frac * width)))
    return "#" * filled + "-" * (width - filled)


def measure_sglang(base: str, model: str, cls: str, runs: int, max_tokens: int,
                   timeout: float) -> dict:
    """Accept LENGTH only, because that is all SGLang publishes.

    No deltas are taken. The number on /server_info is an exponential moving
    average maintained across verify passes, so subtracting two readings does
    not isolate this run - it produces a difference of two smoothed values,
    which is not a measurement of anything. Reading it AFTER the generations is
    the honest interpretation of what the server actually exposes.

    The comparable ratio is DERIVED, and the derivation is stated wherever it
    is printed: a verify step accepts `length` tokens of which one is the
    target's own bonus token, out of `k` that were drafted -

        accept_ratio = (accept_length - 1) / k

    so 1.0 means every draft was rejected and `k + 1` means all were taken.
    """
    prompt = PROMPTS[cls]
    results = [stream_once(base, model, prompt, max_tokens, timeout)
               for _ in range(runs)]
    info = server_info(base, timeout)
    st = (info.get("internal_states") or [{}])[0]
    gauges = parse_sglang_metrics(fetch_metrics(base, timeout))

    length = accept_length(info)
    # The verify window, from whichever of the three places reports it. `k` is
    # window - 1: SGLang's own help for --speculative-dspark-block-size says
    # the window is gamma + 1, and gamma is what was drafted.
    window = (gauges.get("sglang:spec_num_draft_tokens")
              or st.get("speculative_num_draft_tokens"))
    k = int(window) - 1 if window else (
        int(st["speculative_num_steps"]) if st.get("speculative_num_steps") else None)

    ratio = None
    if length is not None and k:
        ratio = max(0.0, (length - 1.0) / k)

    return {
        "class": cls,
        "runs": runs,
        "engine": "sglang",
        "drafts": 1 if length is not None else 0,
        "draft_tokens": None,
        "accepted": None,
        "accept_ratio": ratio,
        "accepted_per_step": length,
        "k": k,
        "per_pos": [],
        "tok_s": median([r["tok_s"] for r in results]),
        "ttft_s": median([r["ttft_s"] for r in results]),
        "completion_tokens": median([r["completion_tokens"] for r in results]),
    }


def measure(base: str, model: str, cls: str, runs: int, max_tokens: int,
            timeout: float) -> dict:
    prompt = PROMPTS[cls]
    before = snapshot(base, timeout)
    results = [stream_once(base, model, prompt, max_tokens, timeout)
               for _ in range(runs)]
    after = snapshot(base, timeout)

    def delta(key: str) -> float:
        return after.get(key, 0.0) - before.get(key, 0.0)

    drafts = delta("vllm:spec_decode_num_drafts_total")
    draft_tok = delta("vllm:spec_decode_num_draft_tokens_total")
    accepted = delta("vllm:spec_decode_num_accepted_tokens_total")

    # Per-position keys are discovered from the metrics rather than assumed:
    # k is a serving choice (7 for DFlash2 here, 5 for DSpark next door) and
    # hardcoding a range silently truncates the ladder for the other one.
    positions = sorted(
        (int(k.split(":", 1)[1]) for k in set(before) | set(after)
         if k.startswith("pos:")),
    )
    per_pos = [
        (i, delta(f"pos:{i}") / drafts if drafts else 0.0) for i in positions
    ]

    return {
        "class": cls,
        "runs": runs,
        "engine": "vllm",
        "drafts": int(drafts),
        "draft_tokens": int(draft_tok),
        "accepted": int(accepted),
        "accept_ratio": accepted / draft_tok if draft_tok else None,
        "accepted_per_step": accepted / drafts if drafts else None,
        "k": round(draft_tok / drafts) if drafts else None,
        "per_pos": per_pos,
        "tok_s": median([r["tok_s"] for r in results]),
        "ttft_s": median([r["ttft_s"] for r in results]),
        "completion_tokens": median([r["completion_tokens"] for r in results]),
    }


def verdict(m: dict) -> tuple[str, str]:
    """Name the shape - but only where the shape means something.

    THE CLASS IS PART OF THE TEST, not context for the reader. A healthy prose
    ladder decays to near zero by the last position; a healthy structured one
    stays above ~0.8. Reading a collapse as a broken mask without knowing which
    text was drafted flags a perfectly good server on every prose run, and a
    check with false positives gets muted, at which point it catches nothing.

    So a mask verdict is only ever returned for the structured class.
    """
    pos = [p for _, p in m["per_pos"]]

    # LENGTH-ONLY, which is every SGLang server. There is no ladder to read a
    # shape off, so the only two verdicts available are "the drafter produces
    # something the target takes" and "it does not". Returning a mask verdict
    # here would be inventing evidence, and this tool's whole discipline is
    # that a check which condemns a working server gets muted.
    if m.get("engine") == "sglang":
        length = m.get("accepted_per_step")
        if length is None:
            return ("none", "the server reports no accept length - either the "
                            "speculator is off, or nothing has been verified yet")
        if length <= 1.05:
            return (
                "weak",
                "accept length is at the floor: every drafted token is being "
                "REJECTED and only the target's own bonus token survives. A "
                "drafter that does not match the target checkpoint looks "
                "exactly like this",
            )
        return (
            "ok",
            "the drafter is contributing. SGLang publishes no PER-POSITION "
            "counter, so this cannot tell a weak drafter from a broken draft "
            "mask - serve the same checkpoint under vLLM if you need that "
            "shape (ws up vllm-nemotron35-lightning-nvfp4)",
        )

    if not pos or m["drafts"] == 0:
        return ("none", "no drafts were produced")
    head = pos[0]
    tail = median(pos[max(1, len(pos) // 2):]) or 0.0

    if m.get("class") != "structured":
        # Prose is the hard class by construction. Only a low HEAD says
        # anything here, because everything after it is expected to fall away.
        if head < 0.4:
            return (
                "weak",
                "even position 0 is low, on the class that is already the "
                "harder one. Compare the structured run before concluding "
                "anything about the server",
            )
        return (
            "ok",
            "a steep decay is NORMAL on prose - a healthy server measures "
            "about 0.75 falling to 0.06 across the ladder. Judge the draft "
            "mask on the structured run, not on this one",
        )

    # Structured. A healthy ladder here stays high all the way out, so a
    # collapsed tail behind a healthy head is diagnostic.
    if head >= 0.7 and tail < 0.5:
        return (
            "mask",
            "position 0 is healthy and the later positions collapse, on the "
            "class where a working drafter stays above 0.8 the whole way. "
            "That is the shape of a CAUSAL mask inside a non-causal draft "
            "block - check for a pinned draft attention_backend (TRITON_ATTN) "
            "in the speculative config",
        )
    if head < 0.6:
        return (
            "weak",
            "position 0 is low on the EASY class, where a working drafter is "
            "near 0.98. Suspect a drafter that does not match the target "
            "checkpoint, or draft weights that were not loaded",
        )
    return ("ok", "structured output stays high across the whole ladder - "
                  "this is what a working drafter looks like")


def report_sglang(m: dict) -> None:
    """Same layout, minus the half SGLang does not publish."""
    if m["accepted_per_step"] is None:
        print("    no accept length reported - speculative decoding is OFF, or")
        print("    the server has not verified a batch yet")
        return
    print(f"    accept length         {m['accepted_per_step']:>10.2f}   "
          f"of {(m['k'] or 0) + 1} possible   (EMA, server-side)")
    if m["accept_ratio"] is not None:
        print(f"    acceptance ratio      {m['accept_ratio']:>10.3f}   "
              f"= (length - 1) / k, k = {m['k']}")
    if m["tok_s"]:
        print(f"    decode                {m['tok_s']:>10.1f} tok/s   "
              f"(median, TTFT {m['ttft_s']:.2f}s)")
    print()
    print("    NO ACCEPTANCE-BY-POSITION HERE. SGLang exposes no per-position")
    print("    counter, so the shape that separates a weak drafter from a")
    print("    broken draft mask is not measurable on this engine.")


def report(m: dict) -> None:
    c = m["class"]
    plural = "run" if m["runs"] == 1 else "runs"
    print(f"\n  {c.upper()}  ({m['runs']} {plural}, "
          f"{int(m['completion_tokens'] or 0)} tokens each)")
    if m.get("engine") == "sglang":
        report_sglang(m)
        kind, why = verdict(m)
        mark = {"ok": "  ok  ", "mask": " FLAG ", "weak": " FLAG ", "none": " FLAG "}[kind]
        body = textwrap.wrap(why, width=64)
        print(f"\n    [{mark}] {body[0]}")
        for line in body[1:]:
            print(f"             {line}")
        return
    if m["drafts"] == 0:
        print("    no drafts recorded - speculative decoding is OFF for this server")
        return
    ratio = m["accept_ratio"] or 0.0
    print(f"    drafts                {m['drafts']:>10,}")
    print(f"    draft tokens          {m['draft_tokens']:>10,}   (k = {m['k']})")
    print(f"    accepted              {m['accepted']:>10,}")
    print(f"    acceptance ratio      {ratio:>10.3f}")
    print(f"    accepted per step     {m['accepted_per_step']:>10.2f}   "
          f"of {(m['k'] or 0) + 1} possible")
    if m["tok_s"]:
        print(f"    decode                {m['tok_s']:>10.1f} tok/s   "
              f"(median, TTFT {m['ttft_s']:.2f}s)")
    print()
    if c == "structured":
        print("    ACCEPTANCE BY DRAFT POSITION - healthy stays above ~0.8 throughout")
    else:
        print("    ACCEPTANCE BY DRAFT POSITION - healthy prose DECAYS to near zero")
    for i, p in m["per_pos"]:
        print(f"      pos {i}  [{bar(p)}]  {p:.2f}")
    kind, why = verdict(m)
    mark = {"ok": "  ok  ", "mask": " FLAG ", "weak": " FLAG ", "none": " FLAG "}[kind]
    body = textwrap.wrap(why, width=64)
    print(f"\n    [{mark}] {body[0]}")
    for line in body[1:]:
        print(f"             {line}")


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Per-position speculative-decode acceptance against a live server.",
    )
    ap.add_argument("--base-url", default=os.environ.get("BASE_URL", "http://127.0.0.1:8888/v1"))
    ap.add_argument("--model", default=os.environ.get("MODEL") or None)
    ap.add_argument("--class", dest="cls", default=os.environ.get("PROMPT_CLASS", "both"),
                    # `both` on purpose: prose alone cannot convict, and
                    # structured alone hides that acceptance is text-dependent.
                    choices=["structured", "prose", "both"])
    ap.add_argument("--runs", type=int, default=int(os.environ.get("RUNS", "3")))
    ap.add_argument("--max-tokens", type=int, default=int(os.environ.get("MAX_TOKENS", "400")))
    ap.add_argument("--timeout", type=float, default=float(os.environ.get("TIMEOUT", "600")))
    ap.add_argument("--json", dest="as_json", metavar="PATH",
                    default=os.environ.get("JSON_OUT") or None,
                    help="also write the raw numbers here")
    args = ap.parse_args()

    base = args.base_url
    model = args.model or discover_model(base, args.timeout)

    # Asked BEFORE anything is generated, because the answer decides what may
    # be concluded, not just how the output is formatted.
    engine = detect_engine(base, args.timeout)

    print(f"spec-decode acceptance   {base}   model={model}   engine={engine}")
    print("  a broken draft path costs ACCEPTANCE AND NOTHING ELSE - the target")
    print("  still verifies every token, so the answers stay correct")
    if engine == "sglang":
        print("  SGLang publishes accept LENGTH and no per-position counters, so")
        print("  this run cannot convict a broken draft mask - only an idle drafter")

    classes = ["structured", "prose"] if args.cls == "both" else [args.cls]
    out = []
    for cls in classes:
        fn = measure_sglang if engine == "sglang" else measure
        m = fn(base, model, cls, args.runs, args.max_tokens, args.timeout)
        report(m)
        out.append(m)

    if all(m["drafts"] == 0 for m in out):
        print("\nno speculative decoding on this server - nothing to measure",
              file=sys.stderr)
        return 1

    if len(out) > 1 and engine != "sglang":
        print("\n  Acceptance is a property of the TEXT, so a large gap between these")
        print("  two is normal and is not a server fault - a healthy server measures")
        print("  about 0.92 on structured and 0.33 on prose. The STRUCTURED ladder is")
        print("  the one that can convict a broken draft mask.")

    if args.as_json:
        with open(args.as_json, "w", encoding="utf-8") as fh:
            json.dump(out, fh, indent=2)
        print(f"\n  wrote {args.as_json}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
