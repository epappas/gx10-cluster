# Copy to .env (gitignored) and edit. Every value has a working default.

# Which server. The two-node workspaces serve from rank 0 on this host, so the
# same URL reaches them.
# BASE_URL=http://127.0.0.1:8893/v1     # vllm-2node-glm53-flash-exl3
# BASE_URL=http://127.0.0.1:8890/v1     # vllm-2node-deepseek-v4-flash

# The SERVED name. Discovered from /v1/models when unset.
# MODEL=glm-5.3-flash-exl3

# WHICH TEXT, and this matters more than it looks. Acceptance is a property of
# the text, not of the server: the same healthy server measures ~0.92 on
# structured output and ~0.33 on prose. Comparing a prose run against a
# structured baseline is how a working drafter gets condemned. Default runs
# both, so the spread is visible rather than assumed.
# PROMPT_CLASS=both        # structured | prose | both

# More runs is a tighter median and a longer wait. The counters are cumulative
# and this reads deltas, so other traffic on the server during the run pollutes
# the measurement - do this on an otherwise idle endpoint.
# RUNS=3
# MAX_TOKENS=400

# TIMEOUT=600
# JSON_OUT=/tmp/spec-accept.json
