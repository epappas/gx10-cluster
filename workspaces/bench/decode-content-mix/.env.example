# Copy to .env (gitignored). Everything has a working default.

# The server to measure. This is a CLIENT - it starts nothing.
# BASE_URL=http://127.0.0.1:8896/v1

# Only if the server was started with bearer auth.
# API_KEY=

# Asked of /models by default.
# MODEL=qwen3.8-flash-next

# Everything else is a flag rather than a variable, because these are the knobs
# you turn between two runs you intend to compare:
#   --decode 400        tokens per run
#   --context 1000      filler the `copy` task quotes from
#   --tasks prose,code  a subset
#   --repeat 3          runs per task, averaged
