# Copy to .env (gitignored). Everything has a working default.

# WHICH MODEL, AND WHERE. These are used once, to register the binding in
# exo's own store on the first `ws up`. Exo does NOT update a binding in place:
# to repoint it, set a new EXO_BINDING name as well.
#
#   8888  vllm-qwen3.8-27b-nvfp4 (qwen3.8-27b), vllm-2node-tp2 (nemotron-120b)
#   8890  vllm-2node-deepseek-v4-flash (deepseek-v4-flash)
#   8891  llamacpp-deepseek-v4-flash-gguf
#   8899  llamacpp-qwen3.8-27b-gguf   (served under the HF repo id)
#   8900  sglang-qwen3.8-27b-int4
# EXO_BASE_URL=http://127.0.0.1:8888/v1
# EXO_UPSTREAM=qwen3.8-27b           # the SERVED name, not the HF repo id

# What exo calls the binding. DO NOT name it after an OpenAI model: exo picks
# the Responses API by name - anything matching gpt-5-codex, gpt-5.3+, o1-pro,
# o3-pro or gpt-5-pro - and vLLM and llama.cpp do not serve that API.
# EXO_BINDING=gx10-local

# Any non-empty string. Stored in exo's keystore at registration, so changing
# it afterwards has no effect until you register a new binding.
# LOCAL_API_KEY=gx10

# THE TEMPLATE, AND THE ONE DEFAULT WORTH ARGUING WITH. `minimal` is a local
# REPL and nothing else. `canonical` adds ExoChat, a chat UI hosted at
# exoharness.ai - so your conversation with a model your own cluster is serving
# would travel through someone else's server. `dev` swaps that for IRC+Discord.
# EXO_TEMPLATE=minimal

# WHERE THE CHECKOUT LIVES, and it is STATE: .exo/ inside it holds every agent,
# conversation and event, and exo rewrites the source itself. ~6.8 GB built.
# EXO_SRC=/home/you/src/exo
# EXO_REF=7801005e6a1ab77008a05dbba80e0a2a7a56e35d

# The agent's sandbox. It installs packages in here, not on your host.
# EXO_SANDBOX_IMAGE=ubuntu:24.04
