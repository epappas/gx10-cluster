# Copy to .env (gitignored). Everything has a working default.
#
# The model configuration is NOT here - it lives in settings.example.yaml,
# which you copy to dsh-home/settings.yaml. This file is only for the values
# compose.yml needs.

# What the agent may read and write. THE ONE SETTING WORTH THINKING ABOUT: an
# agent harness with tool access does what it likes inside this directory.
# The default ./work starts empty on purpose. Give it a project, not $HOME.
# DSH_WORKSPACE=/home/you/src/some-project

# Any non-empty string. A locally served model ignores the value; the client
# library refuses to send a request without one.
# LOCAL_API_KEY=gx10

# Only if you also configure the hosted provider in settings.yaml. Leaving this
# unset is a reasonable way to guarantee nothing reaches DeepSeek.
# DEEPSEEK_API_KEY=sk-...

# Pin the harness once a version works for you. Unset means `latest`, which for
# a developer preview means "whatever shipped this week".
# DSH_VERSION=0.1.1-rc.2   # the published tags are all -rc/-alpha; `0.1.0` is not one

# Who the container runs as. Defaults to 1000:1000, which is the usual first
# user on these boxes. Set it if `id -u` says otherwise, or ./dsh-home fills
# with files you cannot edit.
# DSH_UID=1000
# DSH_GID=1000

# NODE_IMAGE=node:22-slim
# START_PERIOD=12m
