# Copy to .env (gitignored). Everything has a working default, and the two
# values worth setting are the first two.

# WHICH MODEL, AND WHERE. These seed pi-agent/models.json on the first `ws up`
# and are ignored after that - the file is yours once it exists. To re-seed,
# delete it.
#
#   8888  vllm-qwen3.8-27b-nvfp4 (qwen3.8-27b), vllm-2node-tp2 (nemotron-120b)
#   8890  vllm-2node-deepseek-v4-flash (deepseek-v4-flash)
#   8891  llamacpp-deepseek-v4-flash-gguf
#   8899  llamacpp-qwen3.8-27b-gguf   (served under the HF repo id)
#   8900  sglang-qwen3.8-27b-int4
# PI_BASE_URL=http://127.0.0.1:8888/v1
# PI_MODEL_ID=qwen3.8-27b            # the SERVED name, not the HF repo id
# PI_PROVIDER_ID=gx10                # what /model lists it under

# WHAT THE AGENT MAY READ AND WRITE. Pi ships no permission system by its own
# README: read, write, edit and bash run as the container user over everything
# mounted here. The default is ./work, which starts empty. Give it a project.
# PI_WORKSPACE=/home/you/src/some-project

# Any non-empty string. A locally served model ignores the value, but a
# provider with no configured auth is hidden from /model entirely.
# LOCAL_API_KEY=gx10

# Startup network calls only - update checks, package updates, telemetry.
# Model requests are unaffected. Set to 0 if you want `pi update` to work.
# PI_OFFLINE=1

# Bump to move pi. The tag of the image is this value, so a bump rebuilds
# rather than reusing the old layer under the same name.
# PI_VERSION=0.84.4
# NODE_IMAGE=node:24-bookworm-slim
# PI_IMAGE=ws-pi-harness:0.84.4
# PI_CONTAINER=ws-pi-harness       # change to run a second session at once
